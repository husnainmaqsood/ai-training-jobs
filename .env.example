# ---------------------------------------------------------------------------
# Orexia AI — environment configuration. Copy to .env and fill in.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Core ---
DEBUG=0
SECRET_KEY=                       # required in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com      # used in emails, sitemaps, Stripe redirect URLs
SITE_NAME=Orexia AI
LOG_LEVEL=INFO
USER_ACCOUNTS_ENABLED=0           # 1 = public sign-up/login, CV builder, billing, saved jobs, tracker (off for the directory-only release)
SHOW_DEMO_JOBS=0                  # 1 = include `seed_demo_jobs` listings in the directory (local development only)
ADMIN_EMAIL=                      # optional: which existing admin to keep when migrating to the single-admin rule

# --- Database (managed PostgreSQL recommended) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_CONN_MAX_AGE=60

# --- Redis / Celery (optional; without Redis tasks run inline in the web process) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=                # defaults to REDIS_URL
CELERY_TASK_ALWAYS_EAGER=         # defaults to 1 when REDIS_URL is empty

# --- Private file storage for uploaded CVs (not web-served) ---
PRIVATE_MEDIA_ROOT=/data/private_media
CV_MAX_UPLOAD_BYTES=5242880
CV_MAX_TEXT_CHARS=30000
JOB_DESCRIPTION_MAX_CHARS=20000

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Orexia AI <no-reply@example.com>
CONTACT_EMAIL=support@example.com

# --- AI provider ---
AI_PROVIDER=openai                # "openai" (production) or "mock" (DEBUG/tests only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini         # any current model that supports structured outputs (JSON schema)
OPENAI_BASE_URL=                  # optional (e.g. Azure/OpenAI-compatible gateway)
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=6000
AI_USER_HOURLY_REQUEST_LIMIT=12
AI_GLOBAL_DAILY_GENERATION_LIMIT=2000
AI_GLOBAL_DAILY_COST_LIMIT_USD=50
# Fallback pricing (USD per 1M tokens) if no ModelPrice row exists in the admin:
AI_MODEL_PRICING=

# --- Billing (Stripe) ---
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=                # sk_live_... / sk_test_...
STRIPE_PUBLISHABLE_KEY=           # not required by the server-side Checkout flow
STRIPE_WEBHOOK_SECRET=            # whsec_... from the webhook endpoint
BILLING_PAST_DUE_GRACE_DAYS=3
# CV-builder credits (one-time Stripe Checkout payments; uses the Stripe keys above)
CREDIT_CURRENCY=usd
# CREDIT_PACKS=[{"code": "single", "credits": 1, "price_cents": 200, "label": "Single CV"}]
BILLING_TEST_MODE=0               # 1 = free "test credits" button when Stripe isn't configured. Never in production.

# --- Referral click hashing ---
CLICK_HASH_SALT=                  # random string; defaults to SECRET_KEY

# --- Security ---
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_PRELOAD=0
